# انسخ هذا الملف إلى .env.local للتطوير المحلي. لا ترفع القيم الحقيقية للمستودع.

# من Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# المفتاح السري. للسيرفر فقط، ولا يوضع أبدًا في متغير يبدأ بـ NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# للتطوير المحلي من غير Supabase فقط: كلمة مرور دخول لوحة المقهى.
# لا تأثير لها على الموقع المنشور.
DEV_STAFF_PASSWORD=
